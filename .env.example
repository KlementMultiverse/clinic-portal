# Django
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# Database (PostgreSQL — required by django-tenants)
DB_NAME=clinic_portal
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Tenant configuration
PUBLIC_DOMAIN=portal.localhost
TENANT_USERS_DOMAIN=localhost

# Admin user (used by create_public_tenant command)
ADMIN_EMAIL=admin@clinic-portal.local
ADMIN_PASSWORD=changeme123

# AWS
AWS_S3_BUCKET=clinic-portal-docs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LAMBDA_SUMMARIZE_ARN=
